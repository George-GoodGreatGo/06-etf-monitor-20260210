{
  "watch": ["server"],
  "ext": "ts,mts,js,json",
  "ignore": [
    "server/dist/*",
    "server/python/.cache/*",
    "server/python/.cache/**",
    "server\\python\\.cache\\*",
    "server\\python\\.cache\\**",
    "server/python/__pycache__/*",
    "server/python/__pycache__/**",
    "server\\python\\__pycache__\\*",
    "server\\python\\__pycache__\\**"
  ],
  "exec": "tsx server/server.ts",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000
}
